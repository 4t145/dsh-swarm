{
  "name": "@local/dsh-swarm",
  "version": "0.2.1",
  "private": true,
  "description": "Single-host peer workers with isolated worktrees and verified Git integration for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.1-rc.4"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    },
    "./headless": {
      "types": "./lib/types/headless.d.ts",
      "default": "./lib/headless.js"
    },
    "./headless-app": {
      "types": "./lib/types/headless-driver.d.ts",
      "default": "./lib/headless-driver.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "cordis.headless.yml",
    "locale",
    "icon.svg",
    "USAGE.md",
    "examples",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:native-headless": "pnpm build && node scripts/test-native-headless.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "link:harness": "node scripts/link-harness.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "license": "MIT"
}
