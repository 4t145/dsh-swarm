{
  "name": "@local/dsh-swarm",
  "version": "0.1.0",
  "private": true,
  "description": "Single-host peer workers with isolated worktrees and verified Git integration for DeepSeek Harness",
  "type": "module",
  "engines": { "node": ">=24.9", "dsh": "0.2.1-rc.4" },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./worker": { "types": "./lib/types/worker.d.ts", "default": "./lib/worker.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "USAGE.md", "examples", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "link:harness": "node scripts/link-harness.mjs"
  },
  "dependencies": { "zod": "4.4.3" },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.5" },
  "license": "MIT"
}
